# AI-based Citizen Grievance Redressal & Tracking System
# District Development Office - Botad (બોટાદ)

# Gemini API Key for Gujarati Speech-to-Text & AI Routing
# (Can be obtained free from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# SQLite Database URL
DATABASE_URL=sqlite+aiosqlite:///./botad_grievances.db

# SMS / WhatsApp Notification Simulator Mode
ENABLE_SMS_SIMULATOR=True
SMS_GATEWAY_PROVIDER=mock  # Options: mock, twilio, gupshup
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SLA & Escalation Settings (in hours)
SLA_HOURS_DRINKING_WATER=48
SLA_HOURS_ELECTRICITY=24
SLA_HOURS_SANITATION=72
SLA_HOURS_PENSIONS=168
SLA_HOURS_ROADS=360
SLA_HOURS_DEFAULT=120

